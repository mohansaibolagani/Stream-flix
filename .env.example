# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication
JWT_SECRET=streamflix_super_secure_jwt_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Database Configuration (Leave empty to use auto-resilient local storage, or provide your MongoDB Atlas / local URI)
MONGODB_URI=mongodb://127.0.0.1:27017/streamflix

# Initial Admin Bootstrap Credentials (Used to create first admin on first launch)
ADMIN_EMAIL=admin@streamflix.com
ADMIN_PASSWORD=Admin@12345
ADMIN_USERNAME=admin
ADMIN_FULLNAME=System Administrator

# Frontend URL for CORS (if separate)
FRONTEND_URL=http://localhost:5000
